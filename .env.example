# Copy this file to .env. Never commit .env.
# Optional: add your key on the next line (remove the #). Without it the app runs in rule-based mode.
# ANTHROPIC_API_KEY=sk-ant-...
PELLIPLAN_MODEL=claude-sonnet-5-5
# Demo mode lets the UI start a demo wedding. Turn it OFF for anything real.
PELLIPLAN_DEMO=1
